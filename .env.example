# Copiá este archivo a `.env` en el servidor y completá los valores.
# El `.env` real NO se commitea (contiene secretos).

# --- Base de datos (Postgres en Docker) ---
POSTGRES_USER=pasos
POSTGRES_DB=pasos
POSTGRES_PASSWORD=cambia-esto-por-una-clave-fuerte

# --- Credenciales del panel admin ---
AUTH_USERNAME=pasossaludables
AUTH_PASSWORD=cambia-esto
ADMIN_USERNAME=pasossaludables
ADMIN_PASSWORD=cambia-esto

# Nota: DATABASE_URL se arma solo dentro de docker-compose a partir de
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB apuntando al servicio `db`.
