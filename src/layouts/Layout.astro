---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Pasos Saludables Stock - tienda y dashboard sobre la base real del stock'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173b2d" />
    <link rel="icon" type="image/jpeg" href="/pasossaludablesstock-logo.jpeg" />
    <link rel="shortcut icon" href="/pasossaludablesstock-logo.jpeg" />
    <link rel="apple-touch-icon" href="/pasossaludablesstock-logo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Plus+Jakarta+Sans:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        try {
          if (window.location.pathname.indexOf('/admin') === 0) return;

          var uid = function () {
            return (
              Date.now().toString(36) +
              '-' +
              Math.random().toString(36).slice(2, 12)
            );
          };

          var visitorId = window.localStorage.getItem('pss-visitor-id');
          if (!visitorId) {
            visitorId = uid();
            window.localStorage.setItem('pss-visitor-id', visitorId);
          }

          var sessionId = window.sessionStorage.getItem('pss-session-id');
          if (!sessionId) {
            sessionId = uid();
            window.sessionStorage.setItem('pss-session-id', sessionId);
          }

          var send = function (type) {
            fetch('/api/analytics/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                type: type,
                visitorId: visitorId,
                sessionId: sessionId,
                path: window.location.pathname,
                referrer: document.referrer || ''
              })
            }).catch(function () {});
          };

          send('pageview');

          // Latido cada 60s mientras la pestana este visible: alimenta el "online ahora".
          window.setInterval(function () {
            if (!document.hidden) send('heartbeat');
          }, 60000);
        } catch (error) {
          /* el tracking nunca debe romper la pagina */
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  html {
    scroll-behavior: smooth;
    /* Escala compacta sin usar zoom: zoom rompe los calculos de posicion de Recharts. */
    font-size: 15px;
  }

  body {
    margin: 0;
    background: #eef5e1;
    color: #14231a;
    font-family: 'Plus Jakarta Sans', 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
  }

  * {
    box-sizing: border-box;
  }

  ::selection {
    background: #8dc63f;
    color: #10301f;
  }

  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: #c6d8a8;
    border: 2px solid #f3f8eb;
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #8dc63f;
  }
</style>
