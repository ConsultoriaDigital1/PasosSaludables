---
// Maqueta V4 "Editorial": tipografía protagonista y casi sin "botones" clásicos.
// Las acciones secundarias viven como enlaces subrayados dentro del texto,
// el CTA principal es una banda ancha al pie del hero y WhatsApp queda como
// botón flotante (FAB) fijo abajo a la derecha, en desktop y mobile.
import Layout from '../../layouts/Layout.astro';
import CampoFondo from '../../components/disenos/CampoFondo.astro';
import ControlesDiseno from '../../components/disenos/ControlesDiseno.astro';
import { productosDemo, pasosDemo } from '../../components/disenos/demo';
import { formatPriceARS } from '../../lib/formatters';

const brandLogo = '/pasossaludablesstock-logo.jpeg';
---

<Layout
  title="Diseño V4 · Editorial — Pasos Saludables"
  description="Maqueta de rediseño V4: tipografía editorial, banda CTA y botón flotante"
>
  <CampoFondo />

  <div class="relative z-10 min-h-screen pb-24 text-slate-950">
    <header class="sticky top-0 z-30 border-b border-[#173b2d]/10 bg-[#f6fbec]/70 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="#" class="flex items-center gap-2.5">
          <img src={brandLogo} alt="Logo Pasos Saludables" class="h-9 w-9 rounded-full object-cover" />
          <span class="font-serif text-lg text-[#14231a]">Pasos <em class="text-[#578124]">Saludables</em></span>
        </a>

        <nav class="hidden items-center gap-7 text-sm font-semibold text-slate-600 md:flex">
          <a href="#catalogo" class="v4-enlace">Catálogo</a>
          <a href="#destacados" class="v4-enlace">Destacados</a>
          <a href="#como-comprar" class="v4-enlace">Cómo comprar</a>
        </nav>

        <button type="button" class="inline-flex items-center gap-2 text-sm font-bold text-[#173b2d]">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
          Carrito
          <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#173b2d] text-[0.65rem] font-bold text-white">3</span>
        </button>
      </div>
    </header>

    <main>
      <!-- Hero editorial -->
      <section class="mx-auto max-w-6xl px-4 pb-10 pt-14 sm:px-6 sm:pt-24">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-[#578124]">Tienda paraguaya · stock real</p>

        <h1 class="mt-6 max-w-4xl font-serif text-[2.7rem] leading-[1.02] text-[#14231a] sm:text-7xl">
          Comer bien es volver al <em class="text-[#578124]">campo</em>.
        </h1>

        <!-- Distribución V4: las acciones secundarias son enlaces dentro del propio texto -->
        <p class="mt-7 max-w-2xl text-base leading-8 text-slate-700 sm:text-lg sm:leading-9">
          Yerbas, granolas, mieles y despensa natural con stock verificado.
          Mirá los <a href="#destacados" class="v4-enlace v4-enlace--fuerte">productos destacados</a>,
          aprendé <a href="#como-comprar" class="v4-enlace v4-enlace--fuerte">cómo comprar en 3 pasos</a>
          o escribinos directo por WhatsApp con el botón verde.
        </p>

        <!-- CTA principal: banda ancha, ocupa todo el ancho del hero -->
        <a href="#catalogo" class="group mt-10 flex items-center justify-between gap-4 rounded-[24px] bg-[#173b2d] px-6 py-5 text-white shadow-[0_26px_70px_rgba(23,59,45,0.32)] transition hover:-translate-y-1 hover:bg-[#1d4a35] sm:mt-14 sm:px-9 sm:py-7">
          <span class="min-w-0">
            <span class="block font-serif text-xl sm:text-3xl">Ver el catálogo completo</span>
            <span class="mt-1 block text-xs font-semibold text-white/65 sm:text-sm">120+ productos · pedido mínimo {formatPriceARS(150000)}</span>
          </span>
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#8dc63f] text-[#10301f] transition group-hover:translate-x-1.5 sm:h-14 sm:w-14">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </span>
        </a>
      </section>

      <!-- Cómo comprar: lista editorial numerada -->
      <section id="como-comprar" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-12 sm:px-6">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
          <h2 class="font-serif text-3xl leading-tight text-[#14231a] sm:text-4xl">Tres pasos,<br />cero vueltas.</h2>
          <ol class="divide-y divide-[#173b2d]/10">
            {
              pasosDemo.map((paso) => (
                <li class="flex items-baseline gap-5 py-5 first:pt-0 last:pb-0">
                  <span class="font-serif text-2xl text-[#8dc63f] sm:text-3xl">{paso.numero}</span>
                  <div>
                    <h3 class="text-lg font-bold text-[#14231a]">{paso.titulo}</h3>
                    <p class="mt-1 max-w-md text-sm leading-7 text-slate-600">{paso.detalle}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Destacados: fila editorial con scroll horizontal en mobile -->
      <section id="destacados" class="scroll-mt-24 py-10">
        <div class="mx-auto mb-6 flex max-w-6xl items-end justify-between gap-4 px-4 sm:px-6">
          <h2 id="catalogo" class="scroll-mt-24 font-serif text-3xl text-[#14231a] sm:text-4xl">Destacados</h2>
          <a href="#" class="v4-enlace v4-enlace--fuerte shrink-0 text-sm font-bold">Ver todo</a>
        </div>

        <div class="v4-carril flex gap-4 overflow-x-auto px-4 pb-4 sm:px-6 lg:mx-auto lg:max-w-6xl lg:grid lg:grid-cols-3 lg:overflow-visible">
          {
            productosDemo.map((producto) => (
              <article class="group w-[16rem] shrink-0 lg:w-auto">
                <div class="relative flex aspect-[4/5] items-center justify-center overflow-hidden rounded-[26px] shadow-[0_20px_56px_rgba(23,59,45,0.18)] transition group-hover:-translate-y-1.5" style={`background: ${producto.tinte}`}>
                  <svg viewBox="0 0 24 24" class="h-14 w-14 text-white/80 transition duration-500 group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                  {producto.etiqueta && (
                    <span class="absolute left-4 top-4 rounded-full bg-white/90 px-2.5 py-1 text-[0.65rem] font-bold text-[#578124]">{producto.etiqueta}</span>
                  )}
                  <button type="button" class="absolute bottom-4 right-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#173b2d] shadow-lg transition hover:bg-[#edf7d7] active:scale-95" aria-label={`Agregar ${producto.nombre}`}>
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                  </button>
                </div>
                <div class="flex items-baseline justify-between gap-3 px-1 pt-3">
                  <h3 class="line-clamp-1 text-sm font-bold text-[#14231a]">{producto.nombre}</h3>
                  <p class="shrink-0 font-serif text-lg text-[#173b2d]">{formatPriceARS(producto.precio)}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Cierre editorial -->
      <section class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
        <p class="mx-auto max-w-2xl font-serif text-2xl leading-snug text-[#14231a] sm:text-4xl">
          «Cada pedido sale del campo con nombre y apellido.»
        </p>
        <p class="mt-4 text-sm font-semibold text-slate-500">Pasos Saludables · Paraguay</p>
      </section>

      <footer class="pb-8 text-center text-xs font-semibold text-slate-500">
        Maqueta V4 «Editorial» · enlaces en línea, banda CTA y botón flotante
      </footer>
    </main>

    <!-- FAB de WhatsApp: fijo abajo a la derecha en todas las pantallas -->
    <a
      href="#"
      class="group fixed bottom-[4.6rem] right-4 z-40 flex items-center gap-0 rounded-full bg-[#8dc63f] p-4 text-[#10301f] shadow-[0_22px_56px_rgba(141,198,63,0.5)] transition hover:-translate-y-1 hover:bg-[#9fd348] sm:bottom-6 sm:right-6"
      aria-label="Pedir por WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
      <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-bold transition-all duration-300 group-hover:ml-2 group-hover:max-w-[9rem]">Pedir ahora</span>
    </a>
  </div>

  <ControlesDiseno actual={4} />
</Layout>

<style>
  .v4-enlace {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(#8dc63f, #8dc63f);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 100% 2px;
    padding-bottom: 2px;
    transition: background-size 200ms ease, color 200ms ease;
  }

  .v4-enlace:hover {
    background-size: 100% 38%;
    color: #173b2d;
  }

  .v4-enlace--fuerte {
    color: #173b2d;
    font-weight: 700;
  }

  .v4-carril {
    scrollbar-width: none;
  }

  .v4-carril::-webkit-scrollbar {
    display: none;
  }
</style>
