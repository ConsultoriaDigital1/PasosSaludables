---
// Maqueta V2 "Sendero": hero dividido en dos columnas.
// Botones apilados en columna vertical (izquierda); en mobile se convierten
// en una barra de acciones fija abajo, estilo app.
import Layout from '../../layouts/Layout.astro';
import CampoFondo from '../../components/disenos/CampoFondo.astro';
import ControlesDiseno from '../../components/disenos/ControlesDiseno.astro';
import { productosDemo, pasosDemo } from '../../components/disenos/demo';
import { formatPriceARS } from '../../lib/formatters';

const brandLogo = '/pasossaludablesstock-logo.jpeg';
const vitrina = productosDemo.slice(0, 3);
---

<Layout
  title="Diseño V2 · Sendero — Pasos Saludables"
  description="Maqueta de rediseño V2: hero dividido con botones en columna y barra de acciones mobile"
>
  <CampoFondo />

  <div class="relative z-10 min-h-screen pb-36 text-slate-950 sm:pb-24">
    <header class="sticky top-0 z-30 border-b border-white/50 bg-white/60 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a href="#" class="flex shrink-0 items-center gap-2.5">
          <img src={brandLogo} alt="Logo Pasos Saludables" class="h-10 w-10 rounded-full object-cover shadow" />
          <span class="hidden text-sm font-bold lg:block">Pasos Saludables</span>
        </a>

        <label class="relative mx-auto block w-full max-w-lg">
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            placeholder="Buscar producto o categoría"
            class="w-full rounded-full border border-white/80 bg-white/80 px-11 py-2.5 text-sm shadow-sm outline-none backdrop-blur transition focus:border-[#8dc63f] focus:ring-2 focus:ring-[#8dc63f]/25"
          />
        </label>

        <nav class="hidden shrink-0 items-center gap-5 text-sm font-semibold text-slate-600 md:flex">
          <a href="#destacados" class="transition hover:text-[#173b2d]">Destacados</a>
          <a href="#como-comprar" class="transition hover:text-[#173b2d]">Cómo comprar</a>
          <button type="button" class="relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#173b2d] text-white shadow-[0_14px_34px_rgba(23,59,45,0.28)] transition hover:bg-[#21503c]" aria-label="Carrito">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
            <span class="absolute -right-1 -top-1 rounded-full bg-[#8dc63f] px-1.5 text-[0.65rem] font-bold text-[#10301f]">3</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero dividido -->
      <section class="mx-auto grid max-w-7xl items-center gap-10 px-4 pb-12 pt-12 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:pt-20 lg:px-8">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#8dc63f]/50 bg-white/70 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-[#578124] shadow-sm backdrop-blur sm:text-xs">
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
            Del productor a tu casa
          </span>

          <h1 class="mt-6 font-serif text-[2.3rem] leading-[1.06] text-[#14231a] sm:text-5xl lg:text-6xl">
            Un sendero directo entre el <em class="text-[#578124]">campo</em> y tu cocina.
          </h1>

          <p class="mt-5 max-w-lg text-sm leading-6 text-slate-700 sm:text-base sm:leading-7">
            Catálogo con stock verificado, precios claros y pedido final por
            WhatsApp. Sin intermediarios, sin sorpresas.
          </p>

          <!-- Distribución V2: columna vertical de botones anchos con icono + flecha -->
          <div class="mt-8 hidden max-w-sm flex-col gap-3 sm:flex">
            <a href="#catalogo" class="group flex items-center justify-between gap-3 rounded-2xl bg-[#173b2d] px-5 py-4 text-sm font-bold text-white shadow-[0_20px_46px_rgba(23,59,45,0.3)] transition hover:-translate-y-0.5 hover:bg-[#21503c]">
              <span class="flex items-center gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-white/12">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"></path><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>
                </span>
                Ver todo el catálogo
              </span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>

            <a href="#destacados" class="group flex items-center justify-between gap-3 rounded-2xl border border-white/80 bg-white/75 px-5 py-4 text-sm font-bold text-[#173b2d] shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:border-[#8dc63f] hover:bg-white">
              <span class="flex items-center gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-[#edf7d7] text-[#578124]">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 2l2.9 6.26 6.6.57-5 4.46 1.5 6.71L12 16.77 6 20l1.5-6.71-5-4.46 6.6-.57L12 2z"></path></svg>
                </span>
                Productos destacados
              </span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>

            <a href="#" class="group flex items-center justify-between gap-3 rounded-2xl bg-[#8dc63f] px-5 py-4 text-sm font-bold text-[#10301f] shadow-[0_20px_46px_rgba(141,198,63,0.4)] transition hover:-translate-y-0.5 hover:bg-[#9fd348]">
              <span class="flex items-center gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-[#10301f]/10">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
                </span>
                Pedir por WhatsApp
              </span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>

          <p class="mt-6 hidden text-xs font-semibold text-slate-500 sm:block">
            Pedido mínimo {formatPriceARS(150000)} · Respuesta en menos de 24h
          </p>
        </div>

        <!-- Vitrina flotante -->
        <div class="relative mx-auto w-full max-w-md" data-depth="-0.05">
          <div class="rounded-[30px] border border-white/70 bg-white/65 p-5 shadow-[0_30px_80px_rgba(23,59,45,0.18)] backdrop-blur-xl">
            <p class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.18em] text-[#578124]">
              En la canasta de hoy
              <span class="rounded-full bg-[#edf7d7] px-2.5 py-1 text-[0.65rem] text-[#578124]">stock real</span>
            </p>
            <div class="mt-4 space-y-3">
              {
                vitrina.map((producto) => (
                  <article class="flex items-center gap-3 rounded-2xl border border-white/80 bg-white/85 p-3 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl" style={`background: ${producto.tinte}`}>
                      <svg viewBox="0 0 24 24" class="h-6 w-6 text-white/85" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <h3 class="truncate text-sm font-bold text-[#14231a]">{producto.nombre}</h3>
                      <p class="text-sm font-extrabold text-[#578124]">{formatPriceARS(producto.precio)}</p>
                    </div>
                    <button type="button" class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#173b2d] text-white transition hover:bg-[#21503c] active:scale-95" aria-label={`Agregar ${producto.nombre}`}>
                      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                    </button>
                  </article>
                ))
              }
            </div>
            <div class="mt-4 flex items-center justify-between rounded-2xl bg-[#173b2d] px-4 py-3 text-sm font-bold text-white">
              <span>Total estimado</span>
              <span class="text-[#a5d95d]">{formatPriceARS(vitrina.reduce((suma, p) => suma + p.precio, 0))}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Cómo comprar: línea de tiempo horizontal -->
      <section id="como-comprar" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-10 sm:px-6 lg:px-8">
        <div class="rounded-[30px] border border-white/70 bg-white/60 px-6 py-8 shadow-[0_20px_56px_rgba(23,59,45,0.12)] backdrop-blur-xl sm:px-10">
          <h2 class="font-serif text-2xl text-[#14231a] sm:text-3xl">El sendero, en tres pasos</h2>
          <ol class="mt-6 grid gap-6 sm:grid-cols-3 sm:gap-4">
            {
              pasosDemo.map((paso, indice) => (
                <li class="relative flex gap-4 sm:block">
                  <div class="flex flex-col items-center sm:flex-row sm:gap-3">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#173b2d] font-serif text-lg text-[#a5d95d] shadow">{indice + 1}</span>
                    <span class="mt-1 h-full w-px bg-[#c6d8a8] sm:mt-0 sm:h-px sm:w-full"></span>
                  </div>
                  <div class="pb-2 sm:mt-4">
                    <h3 class="text-base font-bold text-[#14231a]">{paso.titulo}</h3>
                    <p class="mt-1 text-sm leading-6 text-slate-600">{paso.detalle}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Destacados -->
      <section id="destacados" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#578124]">Destacados</p>
            <h2 id="catalogo" class="mt-1 scroll-mt-24 font-serif text-2xl text-[#14231a] sm:text-3xl">Lo que más se busca</h2>
          </div>
          <a href="#" class="hidden items-center gap-1.5 text-sm font-bold text-[#578124] transition hover:text-[#173b2d] sm:inline-flex">
            Ver todo
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
          {
            productosDemo.map((producto) => (
              <article class="group overflow-hidden rounded-[22px] border border-white/70 bg-white/80 shadow-[0_14px_40px_rgba(23,59,45,0.1)] backdrop-blur transition hover:-translate-y-1 hover:shadow-[0_24px_60px_rgba(23,59,45,0.16)]">
                <div class="relative flex aspect-[4/3] items-center justify-center" style={`background: ${producto.tinte}`}>
                  <svg viewBox="0 0 24 24" class="h-12 w-12 text-white/80 transition duration-500 group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                  {producto.etiqueta && (
                    <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[0.65rem] font-bold text-[#578124] shadow-sm">
                      {producto.etiqueta}
                    </span>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="line-clamp-2 min-h-[2.4rem] text-sm font-bold leading-tight text-[#14231a]">{producto.nombre}</h3>
                  <div class="mt-3 flex items-center justify-between gap-2">
                    <p class="text-base font-extrabold text-[#173b2d]">{formatPriceARS(producto.precio)}</p>
                    <button type="button" class="inline-flex items-center gap-1.5 rounded-full bg-[#8dc63f] px-3.5 py-2 text-xs font-bold text-[#10301f] shadow-sm transition hover:bg-[#9fd348] active:scale-95">
                      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                      Agregar
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <footer class="pb-8 pt-4 text-center text-xs font-semibold text-slate-500">
        Pasos Saludables · Maqueta V2 «Sendero» · hero dividido, botones en columna + barra mobile
      </footer>
    </main>

    <!-- Distribución V2 en mobile: barra de acciones fija abajo (queda sobre la barra de controles) -->
    <div class="fixed inset-x-3 bottom-[4.4rem] z-40 flex gap-2 rounded-2xl border border-white/60 bg-[#0f2a1d]/92 p-2 shadow-[0_20px_50px_rgba(15,42,29,0.4)] backdrop-blur-xl sm:hidden">
      <a href="#catalogo" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-white/10 px-3 py-3 text-sm font-bold text-white transition active:scale-95">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"></path><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path></svg>
        Catálogo
      </a>
      <a href="#" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#8dc63f] px-3 py-3 text-sm font-bold text-[#10301f] transition active:scale-95">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
        Pedir ahora
      </a>
    </div>
  </div>

  <ControlesDiseno actual={2} />
</Layout>
